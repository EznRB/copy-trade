# =====================================================================
# Copie para .env e preencha. NUNCA commitar o .env.
# Politica completa: docs/security/secret-policy.md
# =====================================================================

# --- MODO DE OPERACAO ---
# Valores: PAPER | SHADOW | LIVE. DEFAULT ABSOLUTO: PAPER.
TRADING_MODE=PAPER

# Segunda trava obrigatoria para LIVE. Trades reais somente se
# TRADING_MODE=LIVE **e** LIVE_TRADING_ENABLED=true.
LIVE_TRADING_ENABLED=false

# Kill switch global: true = nao abrir novas posicoes.
TRADING_KILL_SWITCH=false

# --- LIMITES DE RISCO (mudancas exigem audit log — ver AGENTS.md) ---
MAX_TRADE_SOL=0.01
MAX_POSITION_SOL=0.05
MAX_TOTAL_EXPOSURE_SOL=0.1
MAX_DAILY_LOSS_SOL=0.05
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_DAY=10

# --- SOLANA / RPC ---
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
# SOLANA_RPC_WSS=wss://api.mainnet-beta.solana.com
# HELIUS_API_KEY=

# --- BOT HOT WALLET ---
# SOMENTE public key aqui. NUNCA private key / seed phrase em arquivo algum.
# A private key existe apenas no ambiente de execucao seguro (secret manager).
# BOT_WALLET_PUBLIC_KEY=

# --- BANCO DE DADOS ---
# Postgres local nativo (ver docs/operations/database-setup.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copytrade

# --- TELEGRAM ALERTAS (opcional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- API / DASHBOARD ---
API_PORT=3001
# SESSION_SECRET=
